# Template Dockerfile for one package. Copy to Dockerfile.{package_name} at the
# repo root (Dockerfiles live here, not inside packages, because a service image
# usually needs data-models / data-utils alongside its own package) and replace
# every {package_name} / {package_module} placeholder.
#
#   docker build -f Dockerfile.{package_name} -t {image_name} .
#
# {package_name}   - directory name under packages/, e.g. chat-api
# {package_module} - importable module name, e.g. chat_api

FROM ghcr.io/astral-sh/uv:python3.13-bookworm-slim AS builder

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=never

WORKDIR /app

# Cross-package dependencies must be copied before the lockfile is resolved.
COPY packages/data-models /app/packages/data-models
COPY packages/data-utils /app/packages/data-utils

COPY packages/{package_name}/pyproject.toml packages/{package_name}/uv.lock /app/packages/{package_name}/

# Dependencies resolve in their own layer so source edits do not invalidate them.
RUN --mount=type=cache,target=/root/.cache/uv \
    cd /app/packages/{package_name} && uv sync --locked --no-install-project --no-dev

COPY packages/{package_name} /app/packages/{package_name}

RUN --mount=type=cache,target=/root/.cache/uv \
    cd /app/packages/{package_name} && uv sync --locked --no-dev


FROM python:3.13-slim-bookworm AS runtime

RUN useradd --create-home --uid 10001 app

WORKDIR /app/packages/{package_name}

COPY --from=builder --chown=app:app /app /app

ENV PATH="/app/packages/{package_name}/.venv/bin:$PATH" \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

USER app

EXPOSE 8000

CMD ["python", "-m", "{package_module}", "--host", "0.0.0.0", "--port", "8000"]
