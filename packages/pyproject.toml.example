[project]
name = ""
version = "0.1.0"
description = ""
requires-python = "==3.13.*"
dependencies = [
    "fastapi>=0.138.0,<1.0.0",
    "pydantic>=2.13.0,<3.0.0",
    "pydantic-settings>=2.14.0,<3.0.0",
    "python-dotenv>=1.2.0,<2.0.0",
    "pyyaml>=6.0.0,<7.0.0",
    "uvicorn[standard]>=0.49.0,<1.0.0",
]

[dependency-groups]
dev = [
    "httpx>=0.28.1,<1.0.0",
    "pytest>=9.0.0,<10.0.0",
    "pytest-asyncio>=1.4.0,<2.0.0",
    "taskipy>=1.14.0,<2.0.0",
    "ruff>=0.15.0,<1.0.0",
    "tach>=0.35.0,<1.0.0",
]

[tool.ruff]
line-length = 120
target-version = "py313"

[tool.ruff.format]
docstring-code-format = true
quote-style = "double"

[tool.ruff.lint]
select = ["A", "B", "C", "E", "F", "W", "I", "UP", "FURB", "RUF"]
exclude = [".venv"]
ignore = ["E501", "C901"]

[tool.ruff.lint.pydocstyle]
convention = "google"

[tool.pyright]
venvPath = "."
venv = ".venv"

[tool.taskipy.tasks]
precommits = { cmd = "uvx ruff format . && uvx ruff check . --fix --unsafe-fixes && uvx pyright . && uvx tach check && npx --yes markdownlint-cli@0.49.1 '**/*.md' --ignore .venv", help = "Lint, format and typecheck Python codebase, check module boundaries, and lint Markdown docs" }
tach = { cmd = "uvx tach check", help = "Check module boundaries against tach.toml" }
app = { cmd = "uv run python -m app --port 8000", help = "Run API dev server" }
openapi = { cmd = "uv run python -m app --openapi", help = "Generate OpenAPI spec for chatbot API" }

[tool.pytest.ini_options]
asyncio_mode = "auto"
asyncio_default_fixture_loop_scope = "function"
testpaths = ["tests"]
pythonpath = ["."]

[tool.uv]
package = false

[tool.uv.sources]
logger = { git = "https://github.com/konrad-woj/logger.git" }
