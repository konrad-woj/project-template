# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/

# Virtual environments
.venv/
venv/
env/

# Node
node_modules/

# uv
.uv/

# Testing
.pytest_cache/
.coverage
coverage.xml
htmlcov/

# Type checking
.mypy_cache/
.pyright/

# Ruff
.ruff_cache/

# Environment variables
.env
.env.*
!.env.example

# IDE
.vscode/
**/.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# Jupyter
.ipynb_checkpoints/
# Exploratory notebooks are committed under packages/*/notebooks/; stray
# notebooks anywhere else are scratch and stay untracked.
*.ipynb
!packages/*/notebooks/*.ipynb

# Docs generated
docs/_build/

# Data / artifacts
*.pkl
*.parquet
*.csv
*.jsonl
results/
# Small fixtures checked in alongside tests are exempt from the rules above.
!**/tests/**/fixtures/**

# Claude
# .claude/settings.json and CLAUDE.md are shared project config and must stay
# tracked. Per-machine overrides are ignored, and .claude/skills/ is vendored
# from the skillset repo by sync_skills.sh rather than committed here.
.claude/settings.local.json
.claude/*.local.json
.claude/skills/
CLAUDE.local.md
