# Copy to .env at the repo root, and to packages/{package_name}/.env for any
# package that needs its own keys. Never commit a populated .env.

GEMINI_API_KEY=
OPENAI_API_KEY=

# OpenWiki (repo docs agent) - defaults, not secrets
OPENWIKI_PROVIDER=gemini
OPENWIKI_MODEL_ID=gemini-2.5-flash

# --- OpenWiki: fully local/offline alternative to GEMINI_API_KEY above ---
# Uncomment to run OpenWiki against a self-hosted OpenAI-compatible server
# (e.g. Ollama, LM Studio, vLLM) instead of a cloud API. Local servers often
# ignore the API key value, but OpenWiki still requires one to be set.
# OPENWIKI_PROVIDER=openai-compatible
# OPENAI_COMPATIBLE_BASE_URL=http://localhost:11434/v1   # Ollama default
# OPENAI_COMPATIBLE_API_KEY=local
# OPENWIKI_MODEL_ID=llama3.2
